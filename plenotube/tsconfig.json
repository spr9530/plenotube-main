{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "paths": {
      "@/*": ["./src/*"]
    },

    /* Important changes */
    "allowJs": true,                // <-- ALLOWS .jsx imports
    "checkJs": false,               // <-- prevents errors for JSX files
    "isolatedModules": false,       // <-- allows mixed TS + JS safely
    "noEmit": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,

    "jsx": "react-jsx",

    /* Linting (softened to allow build) */
    "strict": false,                // <-- optional, but prevents many errors
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },

  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
